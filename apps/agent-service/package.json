    "@ui-agent/contracts": "workspace:*",
    "@ui-agent/ui-change-agent": "workspace:*",
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": { "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
