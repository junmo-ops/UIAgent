{
  "name": "@ui-agent/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "package:extension": "node --import tsx scripts/package-extension-release.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.7.0",
    "@ui-agent/agent-runtime": "workspace:*",
    "@ui-agent/contracts": "workspace:*",
    "hono": "^4.9.0",
    "linkedom": "^0.18.13",
    "tsx": "^4.22.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
