{
  "name": "@ui-agent/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "package:extension": "node --import tsx scripts/package-extension-release.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "skills:check": "node --import tsx src/skills/check.ts",
    "storage:migrate": "node --import tsx src/storage/migrate-workspaces.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.7.0",
    "@ui-agent/agent-runtime": "workspace:*",
    "@ui-agent/contracts": "workspace:*",
    "esbuild": "0.28.1",
    "hono": "^4.9.0",
    "linkedom": "^0.18.13",
    "tsx": "^4.22.1",
    "zod": "^4.0.0",
    "aws-sdk": "2.1184.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
