# 普通参数填写 config/service.json 与 config/workspace-storage.json。
# 本地开发可复制本文件为 .env；生产凭证通过平台 Secret 注入。
MODEL_API_KEY=
# 可选 Qwen 模型密钥；同时需配置 model.alternatives，不能复用 DeepSeek 密钥
# DASHSCOPE_API_KEY=
# 可选 Kimi 模型密钥；同时需配置 model.alternatives
# MOONSHOT_API_KEY=
# 可选 OpenAI 官方 API 密钥；model.alternatives 配置 apiProtocol: responses
# OPENAI_API_KEY=
# installation 管理员用户 ID，多个用英文逗号分隔；留空表示无管理员
# INSTALLATION_ADMIN_USER_IDS=
# installation 身份模式需要至少 32 字符的稳定随机密钥
# INSTALLATION_TOKEN_SECRET=
# S3 模式需要以下两项；使用临时凭证时再提供 SESSION_TOKEN
# WORKSPACE_S3_ACCESS_KEY_ID=
# WORKSPACE_S3_SECRET_ACCESS_KEY=
# WORKSPACE_S3_SESSION_TOKEN=
# 仅平台需要覆盖监听配置时填写；镜像默认监听 0.0.0.0:8787
# HOST=127.0.0.1
# PORT=8787
# 企业 CA 由 Node 加载，按需设置
# NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem
