PORT=8787
HOST=127.0.0.1
# Local development uses one explicit development identity. Production fails closed until
# an SSO/OAuth Authenticator adapter is injected; never enable insecure dev auth publicly.
AUTH_MODE=development
# DEV_AUTH_USER_ID=local-developer
# DEV_AUTH_TENANT_ID=local
# 内网试点部署改为 installation，并使用密码管理器生成至少 32 字符的随机密钥。
# AUTH_MODE=installation
# INSTALLATION_TOKEN_SECRET=replace-with-a-long-random-secret
# INSTALLATION_TENANT_ID=internal-pilot
# 普通安装身份无全局日志权限；仅为指定安装身份授予管理员权限（逗号分隔）。
# 身份持有者可携带自己的 Bearer Token 调用 GET /v1/auth/me 查看 userId。
# INSTALLATION_ADMIN_USER_IDS=
# INSTALLATION_TOKEN_TTL_SECONDS=31536000
# PREVIEW_TOKEN_TTL_SECONDS=604800
# 远程部署时设置为网关对外的 HTTPS 根地址，例如 https://ui-agent.example.com
# PUBLIC_BASE_URL=
# CORS_ORIGIN=*
# CLINE_MAX_ITERATIONS=30
# 单次模型调用的最大输出 token（包含模型推理）；默认 8192。
# CLINE_MAX_OUTPUT_TOKENS=8192
MODEL_MODE=remote
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=your-deepseek-api-key
MODEL_NAME=deepseek-v4-flash
# A 方案（冻结计算样式）仅用于诊断，默认关闭；副本生成直接使用 B 方案作者 CSS。
REPLICA_A_ENABLED=false
LOG_FILE=.logs/agent-turns.jsonl
